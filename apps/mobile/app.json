{
  "expo": {
    "name": "Chiba",
    "slug": "chiba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "chiba",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chiba.app"
    },
    "android": {
      "package": "com.chiba.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F5",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Chiba dùng camera để quét mã QR tích điểm của khách."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Chiba truy cập thư viện ảnh để chọn ảnh sản phẩm."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
