# Sao chép thành apps/mobile/.env rồi điền. Đổi xong phải chạy lại `npx expo start`.

# Địa chỉ API. Để trống = tự dùng IP máy tính đang chạy Expo, cổng 3001 (điện thoại chung Wi-Fi).
# Ví dụ: https://chiba-api.up.railway.app  hoặc  https://xxx.trycloudflare.com/api
EXPO_PUBLIC_API_URL=

# Tài khoản nhận chuyển khoản (hiện mã VietQR ở chi tiết đơn) — giống NEXT_PUBLIC_BANK_* bên web
EXPO_PUBLIC_BANK_ID=
EXPO_PUBLIC_BANK_ACCOUNT_NO=
EXPO_PUBLIC_BANK_ACCOUNT_NAME=
