// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// USER MANAGEMENT
// ================================
enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  fullName     String
  phone        String?
  address      String?
  customerCode String  @unique
  zenPoints    Int     @default(0)
  role         Role    @default(CUSTOMER)
  isSuspended  Boolean @default(false)

  cart   Cart?
  orders Order[]

  hashedRefreshToken   String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ================================
// PRODUCT MANAGEMENT
// ================================
enum ProductCategory {
  MON_NUOC
  TOPPING
  BANH
}

model Product {
  id          String          @id @default(uuid())
  name        String          @unique
  price       Int
  imageUrl    String
  category    ProductCategory @default(MON_NUOC)
  isAvailable Boolean         @default(true)

  cartItems        CartItem[]        @relation("CartItem")
  cartItemToppings CartItemTopping[] @relation("CartItemTopping")

  orderItems    OrderItem[]
  orderToppings OrderItemTopping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ================================
// CART MANAGEMENT
// ================================
model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart     Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product  Product           @relation("CartItem", fields: [productId], references: [id], onDelete: Cascade)
  toppings CartItemTopping[]

  @@map("cart_items")
}

model CartItemTopping {
  id         String @id @default(uuid())
  cartItemId String
  toppingId  String

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  topping  Product  @relation("CartItemTopping", fields: [toppingId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, toppingId])
  @@map("cart_items_toppings")
}

// ================================
// ORDER MANAGEMENT
// ================================
enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id        String @id @default(uuid())
  orderCode String @unique @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderType     OrderType
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Snapshot địa chỉ tại thời điểm đặt hàng
  deliveryAddress String?
  customerName    String?
  customerPhone   String?

  // Giá trị tiền tại thời điểm checkout, đơn vị VND
  subtotal       Int
  pointsUsed     Int @default(0)
  discountAmount Int @default(0)
  shippingFee    Int @default(0)
  totalAmount    Int

  // Điểm dự kiến nhận được khi đơn hoàn tất
  earnedPoints Int @default(0)

  note String?

  items OrderItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Có thể null nếu sản phẩm bị xóa về sau
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot thông tin sản phẩm
  productName  String
  productImage String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int

  toppings OrderItemTopping[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderItemTopping {
  id String @id @default(uuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  toppingId String?
  topping   Product? @relation(fields: [toppingId], references: [id], onDelete: SetNull)

  // Snapshot topping
  toppingName String
  unitPrice   Int

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([toppingId])
}
