// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  fullName           String
  phone              String
  address            String
  customerCode       String             @unique
  zenPoints          Int                @default(0)
  role               Role               @default(CUSTOMER)
  isSuspended        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orders             Order[]
  pointTransactions  PointTransaction[]
  sessions           Session[]

  @@map("users")
}

// Mỗi lần đăng nhập trên một thiết bị là một phiên riêng, nên đăng nhập
// điện thoại không làm máy tính bị đăng xuất.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 của refresh token hiện tại (xoay vòng mỗi lần gia hạn)
  tokenHash  String
  userAgent  String   @default("")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Admin mời email làm nhân viên; người đăng ký bằng email này sẽ thành STAFF.
model StaffInvite {
  email       String   @id
  invitedById String?
  createdAt   DateTime @default(now())

  @@map("staff_invites")
}

// ----- Chi nhánh -----

model Store {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String   @default("")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("stores")
}

// ----- Sản phẩm -----

enum ProductCategory {
  MON_NUOC
  TOPPING
  BANH
}

model Product {
  id          String          @id @default(cuid())
  name        String
  price       Int
  category    ProductCategory
  // Đường dẫn ảnh do server lưu, ví dụ "/uploads/products/p1-1730000000.webp"
  imageUrl    String?
  // false = "Tạm hết": khách không đặt được
  isAvailable Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, sortOrder])
  @@map("products")
}

// ----- Đơn hàng -----

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  STORE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model Order {
  id             String        @id @default(cuid())
  code           String        @unique
  // Giữ đơn khi tài khoản bị xóa (để đối soát doanh thu)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String        @default("")
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  // Tên chi nhánh tại thời điểm đặt (giữ lại nếu chi nhánh đổi tên/bị xóa)
  storeName      String?
  orderType      OrderType
  address        String?
  paymentMethod  PaymentMethod
  // Ảnh chụp các món tại thời điểm đặt: tên, giá, topping, độ ngọt, đá…
  items          Json
  subtotal       Int
  shippingFee    Int
  pointsUsed     Int           @default(0)
  discountAmount Int           @default(0)
  total          Int
  // Điểm sẽ được cộng khi nhân viên đánh dấu Hoàn thành
  pointsEarned   Int           @default(0)
  status         OrderStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([storeId, createdAt])
  @@map("orders")
}

// ----- Điểm thưởng -----

enum PointTransactionType {
  EARNED_ORDER // Tích điểm từ đơn online
  EARNED_STORE // Tích điểm khi order tại quầy (quét QR)
  REDEEMED_APP // Dùng điểm giảm giá đơn online
  REDEEMED_STORE // Đổi quà/trừ điểm tại quầy
  REFUND // Hoàn điểm khi hủy đơn
  ADMIN_ADJUST // Admin điều chỉnh
}

model PointTransaction {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  points       Int
  pointsBefore Int
  pointsAfter  Int
  type         PointTransactionType
  description  String
  orderId      String?
  // Nhân viên/admin thực hiện (null nếu hệ thống tự động)
  createdById  String?
  createdAt    DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("point_transactions")
}
