DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chiba?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Sinh secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Giới hạn số request / phút (tùy chọn)
API_RATE_LIMIT=300   # mọi API, theo IP
AUTH_RATE_LIMIT=10   # đăng nhập / đăng ký, theo IP + email

# Proxy đứng trước API (để lấy đúng IP khách). Mặc định "loopback" (Next.js rewrite cùng máy).
# Khi deploy sau load balancer / Nginx, đặt theo hướng dẫn "trust proxy" của Express, vd. 1
# TRUST_PROXY=loopback

# Địa chỉ web — dùng trong link "đặt lại mật khẩu" gửi qua email
FRONTEND_URL="http://localhost:3000"

# Gửi email (quên mật khẩu). Để trống SMTP_HOST thì không gửi, link được in ra log của API.
# Gmail: bật Xác minh 2 bước cho tài khoản Gmail → tạo "Mật khẩu ứng dụng" (App password, 16 ký tự)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ten-quan@gmail.com
# SMTP_PASS=mat-khau-ung-dung-16-ky-tu
# MAIL_FROM="Chiba <ten-quan@gmail.com>"

# Theo dõi lỗi (Sentry). Để trống = tắt.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Thư mục lưu ảnh sản phẩm upload (mặc định apps/api/uploads)
# UPLOAD_DIR=/var/lib/chiba/uploads
