{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci && npm run build --workspace=web",
    "watchPatterns": ["apps/web/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm exec --workspace=web -- next start -p $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
