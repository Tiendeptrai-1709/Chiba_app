# Copy thành .env.local rồi điền thông tin thật. Restart `npm run dev` sau khi sửa.
# Các biến NEXT_PUBLIC_* được "đóng băng" vào code lúc build → đổi xong phải build lại.

# Địa chỉ API mà web chuyển tiếp /api/* tới (máy dev để trống = http://localhost:3001)
# API_INTERNAL_URL=http://localhost:3001

# Tài khoản nhận chuyển khoản (hiện mã VietQR khi khách chọn "Chuyển khoản")
# Mã ngân hàng: VCB, TCB, MB, ACB, BIDV, VPB, ... (hoặc BIN 6 số, vd. 970436)
NEXT_PUBLIC_BANK_ID=
NEXT_PUBLIC_BANK_ACCOUNT_NO=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# Theo dõi lỗi phía trình duyệt (Sentry). Để trống = tắt.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
